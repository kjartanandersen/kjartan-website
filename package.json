{
  "name": "template",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "dev": "webpack serve --open --config webpack.dev.js",
    "build:dev": "webpack --mode development --progress --config webpack.dev.js ",
    "build:prod": "webpack --mode production --progress --config webpack.prod.js",
    "netlify:dev": "yarn build:dev && netlify dev",
    "netlify:prod": "yarn build:prod && netlify dev",
    "netlify:deploy": "netlify deploy --site $NETLIFY_SITE_ID --auth $NETLIFY_ACCESS_TOKEN --prod --dir=dist -m \"$(git log -1 --pretty=format:'%B')\"",
    "tscheck": "tsc",
    "test": "jest"
  },
  "packageManager": "yarn@4.18.0",
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "dependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/babel__core": "^7.20.5",
    "@types/babel__template": "^7.4.4",
    "@types/dotenv-webpack": "^7.0.8",
    "@types/jest": "^30.0.0",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "core-js": "^3.50.0",
    "css-loader": "^7.1.5",
    "dotenv-webpack": "^9.0.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.8",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "netlify-cli": "^27.8.0",
    "style-loader": "^4.0.0",
    "typescript": "^5.9.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
